# For LOCAL development, leave this file unused / commented out - Vite's
# dev server proxy (see vite.config.js) forwards /api requests to your
# local backend automatically, so no configuration is needed.
#
# For a PRODUCTION deploy (Vercel/Netlify), copy this to .env.production
# or set this as an environment variable in your hosting dashboard,
# pointing at your deployed backend's URL:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
